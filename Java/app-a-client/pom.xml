<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.dbfinanceira</groupId>
    <artifactId>app-a-client</artifactId>
    <version>1.0.0</version>
    <name>app-a-client</name>
    <description>App A - cliente OAuth2 (client_credentials) que autentica no Keycloak e chama a App B com o access token (JWT)</description>

    <properties>
        <java.version>21</java.version>
        <!-- add-exports de java.base e incompativel com release; usamos source/target. -->
        <maven.compiler.release></maven.compiler.release>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- API REST para expor um endpoint de demonstracao -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Cliente OAuth2: obtem o access token via client_credentials junto ao Keycloak -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Documentacao do contrato REST via OpenAPI/Swagger (springdoc). A linha 3.0.x e a
             compativel com o Spring Boot 4 (3.0.3 construida sobre o Spring Boot 4.0.5); a 2.x
             visa o Spring Boot 3.x. O spring-boot-starter-parent nao gerencia esta versao. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-resource-server</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Geracao do par de chaves usa APIs internas da JDK (sun.security.tools.keytool.
                 CertAndKeyGen / sun.security.x509.X500Name) para produzir o certificado X.509
                 autoassinado do keystore PKCS12 sem introduzir dependencia nova (decisao em
                 research.md). Isso exige add-exports em compilacao e execucao. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>--add-exports</arg>
                        <arg>java.base/sun.security.x509=ALL-UNNAMED</arg>
                        <arg>--add-exports</arg>
                        <arg>java.base/sun.security.tools.keytool=ALL-UNNAMED</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Add-Exports no manifesto do jar: honrado pela JVM ao executar java -jar (o par
                 de chaves e gerado no boot pela KeyManager). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Add-Exports>java.base/sun.security.x509 java.base/sun.security.tools.keytool</Add-Exports>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- add-exports para mvn spring-boot:run (execucao em desenvolvimento). -->
                    <jvmArguments>--add-exports java.base/sun.security.x509=ALL-UNNAMED --add-exports java.base/sun.security.tools.keytool=ALL-UNNAMED</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
